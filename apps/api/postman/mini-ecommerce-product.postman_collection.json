              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "description": "Required - endpoint ini memerlukan autentikasi"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sepatu Sneakers Premium V2\",\n  \"description\": \"Versi terbaru sepatu sneakers dengan desain lebih modern.\",\n  \"price\": 500000,\n  \"stock\": 80,\n  \"sku\": \"SKU-SNEAKERS-002\",\n  \"images\": [\n    \"https://example.com/images/sneakers-v2-1.jpg\",\n    \"https://example.com/images/sneakers-v2-2.jpg\"\n  ]\n}",
