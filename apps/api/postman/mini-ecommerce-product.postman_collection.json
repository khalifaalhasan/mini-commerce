    {
      "name": "Product",
      "description": "Semua endpoint untuk manajemen produk (`/product`).",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "description": "Required - endpoint ini memerlukan autentikasi"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sepatu Sneakers Premium\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Sepatu sneakers berkualitas tinggi dengan bahan kulit asli dan sol karet anti-slip. Cocok untuk aktivitas sehari-hari.\",\n  \"price\": 450000,\n  \"stock\": 100,\n  \"sku\": \"SKU-SNEAKERS-001\",\n  \"images\": [\n    \"https://example.com/images/sneakers-1.jpg\",\n    \"https://example.com/images/sneakers-2.jpg\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/product",
              "host": ["{{baseUrl}}"],
              "path": ["api", "product"]
            },
            "description": "**[POST] /product**\n\nMembuat produk baru. Memerlukan autentikasi.\n\n**Required fields:**\n- `name` (string) - Nama produk\n- `categoryId` (string, CUID) - ID kategori produk\n- `description` (string) - Deskripsi produk\n- `price` (number, positive) - Harga produk\n- `stock` (number, >= 0) - Stok produk\n\n**Optional fields:**\n- `sku` (string) - Stock Keeping Unit\n- `images` (string[]) - Array URL gambar produk"
          },
          "response": [
            {
              "name": "Create Product - Success 201",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"},
                  {"key": "Authorization", "value": "Bearer {{authToken}}"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sepatu Sneakers Premium\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Sepatu sneakers berkualitas tinggi.\",\n  \"price\": 450000,\n  \"stock\": 100,\n  \"sku\": \"SKU-SNEAKERS-001\",\n  \"images\": [\"https://example.com/images/sneakers-1.jpg\"]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/product",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "product"]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"id\": \"cuid_example_product_id\",\n  \"name\": \"Sepatu Sneakers Premium\",\n  \"slug\": \"sepatu-sneakers-premium\",\n  \"categoryId\": \"cuid_category_id_here\",\n  \"description\": \"Sepatu sneakers berkualitas tinggi.\",\n  \"price\": 450000,\n  \"stock\": 100,\n  \"sku\": \"SKU-SNEAKERS-001\",\n  \"images\": [\"https://example.com/images/sneakers-1.jpg\"],\n  \"deletedAt\": null,\n  \"createdAt\": \"2026-08-16T03:00:00.000Z\",\n  \"updatedAt\": \"2026-08-16T03:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
