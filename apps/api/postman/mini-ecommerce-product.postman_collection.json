                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"data\": [\n    {\n      \"id\": \"cuid_example_product_id\",\n      \"name\": \"Sepatu Sneakers Premium\",\n      \"slug\": \"sepatu-sneakers-premium\",\n      \"price\": 450000,\n      \"stock\": 100,\n      \"createdAt\": \"2026-08-16T03:00:00.000Z\"\n    }\n  ],\n  \"meta\": {\n    \"total\": 1,\n    \"page\": 1,\n    \"limit\": 10,\n    \"totalPages\": 1\n  }\n}"
