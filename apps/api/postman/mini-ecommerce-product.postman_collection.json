    "name": "Mini E-Commerce - Product API",
    "description": "Postman collection untuk Product API pada Mini E-Commerce Backend (NestJS). \n\nGunakan variable `baseUrl` untuk mengatur base URL server.\n\n**Auth:** Endpoint yang tidak memiliki `@AllowAnonymous` memerlukan token autentikasi di header `Authorization: Bearer <token>`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL server. Ubah sesuai environment (dev/staging/prod)."
    },
    {
      "key": "productId",
      "value": "cuid_product_id_here",
      "type": "string",
      "description": "ID produk (CUID) yang digunakan pada endpoint update dan delete."
    },
    {
      "key": "categoryId",
      "value": "cuid_category_id_here",
      "type": "string",
      "description": "ID kategori (CUID) untuk filter produk by category."
    },
    {
      "key": "productSlug",
      "value": "nama-produk-slug",
      "type": "string",
      "description": "Slug produk yang digunakan pada endpoint get by slug."
    },
    {
      "key": "authToken",
      "value": "your_bearer_token_here",
      "type": "string",
      "description": "Bearer token untuk endpoint yang memerlukan autentikasi."
    }
  ],
