      "item": [
        {
          "name": "Create Category 🔒 ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json", "type": "text"},
              {"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text", "description": "Required - Token admin (role: ADMIN)"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Elektronik\",\n  \"description\": \"Kategori untuk produk-produk elektronik seperti smartphone, laptop, dan aksesoris.\"\n}",
